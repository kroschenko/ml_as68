		<properties node_id="0" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00Z\x00\x00\x04\x90\x00\x00\x02\xb8\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom sklearn.datasets import load_digits\nfrom Orange.data import Domain, Table, ContinuousVariable, DiscreteVariable\n\ndigits = load_digits()\n\nattributes = [ContinuousVariable(f"pixel_{i}") for i in range(64)]\nclass_var = DiscreteVariable("digit", values=[str(i) for i in range(10)])\n\ndomain = Domain(attributes, class_var)\n\nout_data = Table.from_numpy(\n    domain,\n    digits.data,\n    digits.target.astype(int)\n)', 'filename': None}], 'scriptText': 'import numpy as np\nfrom sklearn.datasets import load_digits\nfrom Orange.data import Domain, Table, ContinuousVariable, DiscreteVariable\n\ndigits = load_digits()\n\nattributes = [ContinuousVariable(f"pixel_{i}") for i in range(64)]\nclass_var = DiscreteVariable("digit", values=[str(i) for i in range(10)])\n\ndomain = Domain(attributes, class_var)\n\nout_data = Table.from_numpy(\n    domain,\n    digits.data,\n    digits.target.astype(int)\n)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
